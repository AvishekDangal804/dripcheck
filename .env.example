# ── Supabase ──────────────────────────────────────────────────────────────
# Leave all three unset to run DripCheck in local mock mode (in-memory data,
# no external services). Fill in all three to switch to a real Supabase
# project — no application code changes are required either way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser. Used by API routes to write
# fit-check results and upload images, bypassing RLS by design (see
# supabase/policies.sql for why writes are server-controlled only).
SUPABASE_SERVICE_ROLE_KEY=

# ── AI vision provider ───────────────────────────────────────────────────
# Which provider services/ai/analyzeFit.ts should use. Leave unset (or leave
# the matching key below blank) to fall back to the built-in mock analyzer.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Stubbed for future use — see services/ai/providers/
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
